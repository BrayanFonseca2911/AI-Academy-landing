{
  "name": "Campuslands AI Academy · Reto 4 · Registro Landing a Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-ai-academy",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000001",
      "name": "Webhook Landing AI Academy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "lead-ai-academy"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-nombre",
              "leftValue": "={{ $json.body.nombre }}",
              "rightValue": "^[A-Za-zÁÉÍÓÚáéíóúÑñÜü\\s]{3,}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-correo",
              "leftValue": "={{ $json.body.correo }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-programa",
              "leftValue": "={{ $json.body.programa }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1c2d3e4-0002-4000-8000-000000000002",
      "name": "Validar Datos Obligatorios",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-id",
              "name": "folio",
              "value": "={{ $json.body.id || 'AIA-NUEVO' }}",
              "type": "string"
            },
            {
              "id": "set-nombre",
              "name": "nombre",
              "value": "={{ $json.body.nombre }}",
              "type": "string"
            },
            {
              "id": "set-correo",
              "name": "correo",
              "value": "={{ $json.body.correo }}",
              "type": "string"
            },
            {
              "id": "set-programa",
              "name": "programa",
              "value": "={{ $json.body.programa }}",
              "type": "string"
            },
            {
              "id": "set-telefono",
              "name": "telefono",
              "value": "={{ $json.body.telefono ? $json.body.telefono : 'No proporcionado' }}",
              "type": "string"
            },
            {
              "id": "set-estado",
              "name": "estado",
              "value": "={{ $json.body.estado || 'Nuevo' }}",
              "type": "string"
            },
            {
              "id": "set-mensaje",
              "name": "mensajeTelegram",
              "value": "=🚀 *Nuevo interesado · Campuslands AI Academy*\n\n🆔 *Folio:* {{ $json.body.id || 'AIA-NUEVO' }}\n👤 *Nombre:* {{ $json.body.nombre }}\n✉️ *Correo:* {{ $json.body.correo }}\n🎯 *Programa:* {{ $json.body.programa }}\n📞 *Teléfono:* {{ $json.body.telefono ? $json.body.telefono : 'No proporcionado' }}\n📌 *Estado:* {{ $json.body.estado || 'Nuevo' }}\n🕒 *Fecha:* {{ $json.body.fechaLegible || $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1c2d3e4-0003-4000-8000-000000000003",
      "name": "Formatear Aviso Telegram",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_TEST_CHAT_ID || 'CONFIGURAR_CHAT_ID_EN_N8N' }}",
        "text": "={{ $json.mensajeTelegram }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "b1c2d3e4-0004-4000-8000-000000000004",
      "name": "Enviar Aviso por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURAR_CREDENCIAL_EN_N8N",
          "name": "Telegram Bot AI Academy (Configurar en n8n)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"message\": \"Aviso enviado a Telegram correctamente\",\n  \"folio\": \"{{ $('Formatear Aviso Telegram').item.json.folio }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b1c2d3e4-0005-4000-8000-000000000005",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": false,\n  \"error\": \"Datos obligatorios inválidos. No se envió aviso a Telegram.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "b1c2d3e4-0006-4000-8000-000000000006",
      "name": "Rechazar 400 Sin Aviso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        420
      ]
    }
  ],
  "connections": {
    "Webhook Landing AI Academy": {
      "main": [
        [
          {
            "node": "Validar Datos Obligatorios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Datos Obligatorios": {
      "main": [
        [
          {
            "node": "Formatear Aviso Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rechazar 400 Sin Aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Aviso Telegram": {
      "main": [
        [
          {
            "node": "Enviar Aviso por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Aviso por Telegram": {
      "main": [
        [
          {
            "node": "Responder 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
